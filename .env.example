# Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Optional: Neon direct (non-pooler) URL, used for migrations if set
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret for signing JWT (use a long random string, 32+ chars)
JWT_SECRET="change-me-to-a-random-string-of-32-chars-or-more"

# Google AI Studio key
GEMINI_API_KEY="your-gemini-api-key"
# Gemini model name (check AI Studio for a free-tier model)
GEMINI_MODEL="gemini-3-flash-preview"
